    "eslint": "^9.0.0",
    "homebridge": "^2.0.0-beta.0",
    "nodemon": "^3.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.1"
  },
  "dependencies": {
    "@sebbo2002/node-pyatv": "^8.0.0"
